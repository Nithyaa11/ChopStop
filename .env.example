# Copy this file to .env and fill in real values.
# .env is git-ignored. NEVER commit real passwords or keys.

# ---- Database (used by docker-compose and the backend) ----
POSTGRES_DB=chopstop
POSTGRES_USER=chopstop
# Use a long random value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://chopstop:change-me@localhost:5432/chopstop

# ---- Auth ----
# Must be long and random: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=60

# ---- Web ----
# Comma-separated list of allowed frontend origins (no wildcards)
CORS_ORIGINS=http://localhost:5173

# ---- App ----
APP_ENV=development

# ---- AI harness only (optional; the app runs without it) ----
LLM_API_KEY=
# Hard monthly spend cap for the harness, in rupees
LLM_MONTHLY_BUDGET_INR=500
